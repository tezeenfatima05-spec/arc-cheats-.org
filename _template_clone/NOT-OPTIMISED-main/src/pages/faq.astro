---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqPageFaqs } from '../config/faqPageSeo';
import { canonicalUrl, resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SeoResponsiveHeadStyles from '../components/SeoResponsiveHeadStyles.astro';
import { FAQ_SHARE_LABELS } from '../config/sharePageSeo';
import { SITEMAP_ANCHOR_BY_PATH } from '../config/sitemapAnchorSeo';
import { applyBreadcrumbSeo } from '../config/breadcrumbSeo';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = applyBreadcrumbSeo('/faq/', [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
]);

const faqs = getFaqPageFaqs();
const shareUrl = canonicalUrl('/faq/');
const shareQuery = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(seo.title);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <SeoResponsiveHeadStyles />
  <img
    src="/images/hero/gp-showcase-512.webp"
    alt="ARC Raiders cheats FAQ reference imagery"
    width="512"
    height="320"
    class="sr-only"
    loading="lazy"
  />

  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow="Help center"
          title="FAQ for ARC Raiders cheats, access & guides on Steam PC"
          desc="ARC Raiders features, Steam PC compatibility, checkout, risk, and blog topics—in one place."
          titleId="faq-page-title"
          titleTag="h1"
        />
      </div>
    </div>
  </section>

  <h2 class="sr-only">Browse questions by topic</h2>
  <SiteFaqSection
    items={faqs}
    variant="full"
    titleId="faq-page-title"
    showHeader={false}
    questionHeadingTag="h3"
  />

  <nav class="sr-only" aria-label="Related FAQ destinations">
    <ul>
      <li><a href="/support/">Loader ticket email support</a></li>
      <li><a href="/blog/">Overlay setup articles collection</a></li>
      <li><a href="/products/arc-raiders/">Elite tier Raiders listing</a></li>
      <li><a href="/products/cloud-dma/">DMA hardware requirements page</a></li>
      <li><a href="/about/">Who runs this publisher site</a></li>
      <li><a href="/terms/">License and refund terms</a></li>
      <li><a href="/privacy/">Analytics and cookie privacy</a></li>
      <li><a href="/blog/arc-raiders-setup-and-first-launch/">Portal-first setup walkthrough</a></li>
      <li><a href="/forum/">Sample community forum threads</a></li>
      <li><a href="/go/arc-raiders/">Raiders checkout hop from FAQ</a></li>
      <li><a href="/products/">Multi-SKU storefront index</a></li>
      <li><a href="/blog/arc-raiders-setup-and-first-launch/">Setup walkthrough hop from FAQ sr-only</a></li>
      <li><a href="/blog/arc-raiders-aimbot-and-fov-settings/">FOV tuning hop from FAQ sr-only</a></li>
      <li><a href="/sitemap.xml">{SITEMAP_ANCHOR_BY_PATH['/faq/']}</a></li>
    </ul>
  </nav>
  <nav class="sr-only" aria-label="Share this page">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>{FAQ_SHARE_LABELS.x}</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>{FAQ_SHARE_LABELS.facebook}</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>{FAQ_SHARE_LABELS.telegram}</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
