---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqPageFaqs } from '../config/faqPageSeo';
import { canonicalUrl, resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SeoResponsiveHeadStyles from '../components/SeoResponsiveHeadStyles.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getFaqPageFaqs();
const shareUrl = canonicalUrl('/faq/');
const shareQuery = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(seo.title);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <SeoResponsiveHeadStyles />
  <img
    src="/images/hero/gp-showcase-512.webp"
    alt="ARC Raiders cheats FAQ reference imagery"
    width="512"
    height="320"
    class="sr-only"
    loading="lazy"
  />

  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow="Help center"
          title="FAQ for ARC Raiders cheats, access & guides"
          desc="ARC Raiders features, Steam PC compatibility, checkout, risk, and blog topics—in one place."
          titleId="faq-page-title"
          titleTag="h1"
        />
      </div>
    </div>
  </section>

  <SiteFaqSection
    items={faqs}
    variant="full"
    titleId="faq-page-title"
    showHeader={false}
    questionHeadingTag="h2"
  />

  <nav class="sr-only" aria-label="Related FAQ destinations">
    <ul>
      <li><a href="/support/">Email support for loader issues</a></li>
      <li><a href="/blog/">Setup articles on blog hub</a></li>
      <li><a href="/products/arc-raiders/">Raiders software product page</a></li>
      <li><a href="/products/cloud-dma/">Cloud DMA hardware listing</a></li>
      <li><a href="/about/">Publisher about overview</a></li>
      <li><a href="/terms/">Checkout terms of use</a></li>
      <li><a href="/blog/arc-raiders-setup-and-first-launch/">First launch setup walkthrough</a></li>
      <li><a href="/sitemap.xml">FAQ XML sitemap for crawlers</a></li>
    </ul>
  </nav>
  <nav class="sr-only" aria-label="Share this page">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>Share on X</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>Share on Facebook</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>Share on Telegram</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
