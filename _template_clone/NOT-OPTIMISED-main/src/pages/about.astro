---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { canonicalUrl, resolvePageSeo } from '../config/seo';
import { ABOUT_EXTRA_SECTIONS } from '../config/aboutExtra';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import SeoResponsiveHeadStyles from '../components/SeoResponsiveHeadStyles.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';

const shareUrl = canonicalUrl('/about/');
const shareQuery = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(seo.title);

const content = t.legalPages.about;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <SeoResponsiveHeadStyles />
  <img
    src="/images/hero/gp-showcase-512.webp"
    alt="ARC Raiders gameplay with overlay features"
    width="512"
    height="320"
    class="sr-only"
    loading="lazy"
  />
  <LegalPage
    title={content.title}
    pageHeading="About Arc Cheats — publishes Raiders overview"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    extraSections={ABOUT_EXTRA_SECTIONS}
    sectionHeadingTag="h2"
    supportLinkLabel="Ticket support from publisher page"
    homeLinkLabel="Home overview linked from about"
  />
  <nav class="sr-only" aria-label="Related about destinations">
    <ul>
      <li><a href="/blog/">Setup guides index for readers</a></li>
      <li><a href="/faq/">Access questions before checkout</a></li>
      <li><a href="/products/arc-raiders/">Raiders feature hub listing</a></li>
      <li><a href="/products/cloud-dma/">Cloud DMA hardware overview</a></li>
      <li><a href="/support/">Email support desk</a></li>
      <li><a href="/privacy/">Data handling privacy policy</a></li>
      <li><a href="/terms/">Refund and license terms</a></li>
      <li><a href="/blog/arc-raiders-setup-and-first-launch/">First-launch setup article</a></li>
      <li><a href="/sitemap.xml">Public URL sitemap XML</a></li>
    </ul>
  </nav>
  <nav class="sr-only" aria-label="Share this page">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>Share on X</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>Share on Facebook</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>Share on Telegram</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
