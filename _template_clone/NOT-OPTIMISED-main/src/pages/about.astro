---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { canonicalUrl, resolvePageSeo } from '../config/seo';
import { ABOUT_EXTRA_SECTIONS } from '../config/aboutExtra';

const seo = resolvePageSeo('/about/');
import LegalPage from '../components/LegalPage.astro';
import SeoResponsiveHeadStyles from '../components/SeoResponsiveHeadStyles.astro';
import { breadcrumbSchema, organizationSchema, webPageSchema } from '../utils/schema';
import { ABOUT_SHARE_LABELS } from '../config/sharePageSeo';

const shareUrl = canonicalUrl('/about/');
const shareQuery = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(seo.title);

const content = t.legalPages.about;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/about/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about/' },
    ]),
  ]}
>
  <SeoResponsiveHeadStyles />
  <img
    src="/images/hero/gp-showcase-512.webp"
    alt="ARC Raiders gameplay with overlay features"
    width="512"
    height="320"
    class="sr-only"
    loading="lazy"
  />
  <LegalPage
    title={content.title}
    pageHeading="About Arc Cheats — patch status notes for Raiders overview"
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
    extraSections={ABOUT_EXTRA_SECTIONS}
    sectionHeadingTag="h2"
    extraSectionHeadingTag="h3"
    supportLinkLabel="Publisher support mailbox"
    homeLinkLabel="Landing feature overview"
  />
  <nav class="sr-only" aria-label="Related about destinations">
    <ul>
      <li><a href="/blog/">Patch-day walkthrough collection</a></li>
      <li><a href="/faq/">Loader policy Q&amp;A index</a></li>
      <li><a href="/products/arc-raiders/">Raiders elite breakdown page</a></li>
      <li><a href="/products/cloud-dma/">DMA rig compatibility sheet</a></li>
      <li><a href="/products/">Whole multi-SKU catalog</a></li>
      <li><a href="/support/">Install helpdesk tickets</a></li>
      <li><a href="/privacy/">Cookie analytics disclosure</a></li>
      <li><a href="/terms/">Refund and license wording</a></li>
      <li><a href="/forum/">Community thread gallery</a></li>
      <li><a href="/blog/arc-raiders-setup-and-first-launch/">Portal enablement how-to</a></li>
      <li><a href="/go/arc-raiders/">One-click /go/ purchase hop</a></li>
      <li><a href="/sitemap.xml">Crawl manifest from about sr-only nav</a></li>
    </ul>
  </nav>
  <nav class="sr-only" aria-label="Share this page">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>{ABOUT_SHARE_LABELS.x}</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>{ABOUT_SHARE_LABELS.facebook}</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>{ABOUT_SHARE_LABELS.telegram}</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
