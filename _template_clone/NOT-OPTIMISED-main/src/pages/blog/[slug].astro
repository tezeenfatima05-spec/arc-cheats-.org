---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getRelatedBlogPosts } from '../../data/blog';
import { getBlogSeoOverride } from '../../config/blogSeo';
import { getBlogArticleFaqs } from '../../config/blogFaqSeo';
import { getBlogRelatedLinkLabel } from '../../config/blogRelatedSeo';
import { canonicalUrl, resolvePageSeo, resolveSocialImage } from '../../config/seo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { normalizeInternalPath, ROUTES } from '../../utils/path';
import { SITE_DOMAIN } from '../../config/site';
import { isAbsoluteImageUrl, webpSrc, CARD_IMAGE_WIDTHS } from '../../utils/responsiveImage';
import SeoResponsiveHeadStyles from '../../components/SeoResponsiveHeadStyles.astro';
import { blogArticleShareLabels } from '../../config/sharePageSeo';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: postPath },
];

const related = getRelatedBlogPosts(post.slug, 3);

function linkify(text: string): string {
  const domainEsc = SITE_DOMAIN.replace(/\./g, '\\.');
  const absSite = new RegExp(`https://${domainEsc}[^\\s.,;)]*`, 'g');
  const originRe = new RegExp(`^https://${domainEsc}`);
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      const normalized = normalizeInternalPath(href);
      return `<a href="${normalized}">${label}</a>`;
    })
    .replace(absSite, (url) => {
      const path = url.replace(originRe, '');
      const normalized = normalizeInternalPath(path);
      const href = normalized.startsWith('http') ? normalized : `https://${SITE_DOMAIN}${normalized}`;
      return `<a href="${href}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const seo = resolvePageSeo(postPath);
const blogSeo = getBlogSeoOverride(post.slug);
const articleH1 = blogSeo?.h1 ?? post.title;
const shareUrl = canonicalUrl(postPath);
const shareQuery = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(seo.title);
const blogUi = blogSeo;
const shareLabels = blogArticleShareLabels(post.slug);
const articleLcp = isAbsoluteImageUrl(post.image)
  ? post.image
  : webpSrc(post.image, CARD_IMAGE_WIDTHS[0]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  ogType="article"
  ogImage={resolveSocialImage(post.image)}
  ogImageAlt={blogSeo?.imageAlt ?? post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: seo.description,
      url: postPath,
      image: resolveSocialImage(post.image),
      datePublished: published,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="image" href={articleLcp} type="image/webp" fetchpriority="high" />
  <SeoResponsiveHeadStyles />
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" backLabel={blogUi?.toolbarBackLabel} />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <BlogSidebar
          post={post}
          related={related}
          class="order-2 lg:order-1"
          sidebarHeadingsAsParagraphs={blogUi?.sidebarHeadingsAsParagraphs}
          checkoutLinkLabel={blogUi?.checkoutLinkLabel}
          checkoutAriaLabel={blogUi?.checkoutSidebarAria}
          sidebarEliteLabel={blogUi?.sidebarEliteLabel}
          sidebarHubLabel={blogUi?.sidebarHubLabel}
          relatedLinkLabel={(relatedSlug) => getBlogRelatedLinkLabel(post.slug, relatedSlug)}
        />

        <div class="order-1 min-w-0 lg:order-2">
          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={blogSeo?.imageAlt ?? post.title}
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <header class="blog-article__header">
            <h1 class="blog-article__title">{articleH1}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <h2 class="sr-only">Article sections</h2>
          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                    buttonLabel={blogUi?.ctaButtonLabel}
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={checkoutPath()} variant="primary" aria-label={blogUi?.checkoutNavAria ?? t.ui.checkoutAria}>
              {blogUi?.navCheckoutLabel ?? 'Get access'}
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={ROUTES.products} variant="outline">
              {blogUi?.navProductsLabel ?? 'View products'}
            </Button>
            <Button as="a" href={ROUTES.blog} variant="outline">
              {blogUi?.navBlogLabel ?? 'More articles'}
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>
      </div>
    </div>
  </article>

  <nav class="sr-only" aria-label="Related article destinations">
    <ul>
      {blogUi?.srOnlyAnchors?.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
      <li>
        <a href="/sitemap.xml">{blogUi?.sitemapLinkLabel ?? `Sitemap entry list (${post.slug})`}</a>
      </li>
    </ul>
  </nav>
  <h2 id={`blog-faq-${post.slug}`} class="sr-only">
    {blogUi?.faqSectionHeading ?? 'Questions about this guide'}
  </h2>
  <SiteFaqSection
    items={getBlogArticleFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${post.slug}`}
    showHeader={false}
    questionHeadingTag="h3"
    class="border-t border-border bg-muted/20"
  />
  <nav class="sr-only" aria-label="Share this article">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>{shareLabels.x}</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>{shareLabels.facebook}</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>{shareLabels.telegram}</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
