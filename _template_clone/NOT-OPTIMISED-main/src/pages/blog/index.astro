---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogPosts,
  getBlogTags,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { t } from '../../i18n';
import { canonicalUrl, resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';
import { BLOG_INDEX_SHARE_LABELS } from '../../config/sharePageSeo';

const seo = resolvePageSeo('/blog/');
const blogIndexH1 =
  'ARC Raiders cheats guides — setup, patch-day notes for Steam PC, latest articles';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const tags = getBlogTags();
const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';

const shareUrl = canonicalUrl('/blog/');
const shareQuery = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(seo.title);

const BLOG_INDEX_READ_LABELS: Record<string, string> = {
  'arc-raiders-setup-and-first-launch': 'Portal-first enable order',
  'arc-raiders-aimbot-and-fov-settings': 'Smoothing and bone filters',
  'arc-raiders-player-esp-layout': 'Skeleton and squad tag caps',
  'arc-raiders-extraction-and-threat-overlays': 'Exit icons under pressure',
  'arc-raiders-arc-threat-overlays': 'ARC unit marker spacing',
  'arc-raiders-combat-routing-to-extract': 'Peel timing with exit caps',
  'arc-raiders-loot-and-world-esp-filters': 'Rarity loot filter stacks',
  'arc-raiders-misc-camera-and-crosshair': 'FOV and crosshair comfort',
  'arc-raiders-raid-atmosphere-and-arc-zones': 'Zone skim before commits',
};

function blogCardReadLabel(slug: string): string {
  return BLOG_INDEX_READ_LABELS[slug] ?? `Read ${slug.replace(/^arc-raiders-/, '').replace(/-/g, ' ')} on index`;
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    collectionPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <style slot="head" is:inline>
    @media (min-width: 640px) {
      #blog-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .blog-card__footer {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }
    @media (min-width: 1024px) {
      #blog-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>

  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="sr-only">{blogIndexH1}</h1>
      <h2 class="sr-only">Featured guide spotlight</h2>
      <p class="sr-only">Featured ARC Raiders guide</p>
      {featured && (
        <BlogCard
          post={featured}
          index={0}
          eager
          showDate
          layout="featured"
          titleAsParagraph
          readLabel="Read featured setup launch guide"
        />
      )}
    </div>
  </section>

  <section class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <header class="section-header max-w-2xl">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h2 id="blog-latest-title" class="section-header__title">{blogIndexH1}</h2>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>
      <h2 class="sr-only">Filtered ARC Raiders guide articles</h2>

      <div class="mt-8 flex flex-col gap-4 lg:mt-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <div
          class="flex gap-2 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          role="toolbar"
          aria-label="Filter articles by topic"
        >
          <button
            type="button"
            class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
            data-blog-filter="all"
            aria-pressed="true"
          >
            <span class="flex size-7 items-center justify-center rounded-full bg-muted text-primary" aria-hidden="true">
              <Icon name="navBlog" size={15} />
            </span>
            {t.blog.filterAll}
          </button>
          {
            tags.map((tag) => (
              <button
                type="button"
                class="blog-filter inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-medium shadow-xs hover:bg-muted"
                data-blog-filter={tag.toLowerCase()}
                aria-pressed="false"
              >
                <span
                  class="flex size-7 items-center justify-center rounded-full bg-muted text-primary"
                  aria-hidden="true"
                >
                  <Icon name={tagIcon(tag)} size={15} />
                </span>
                {tag}
              </button>
            ))
          }
        </div>

        <BlogSortSelect />
      </div>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {gridPosts.map((post, index) => (
          <BlogCard post={post} index={index} showDate readLabel={blogCardReadLabel(post.slug)} />
        ))}
      </div>

      <p id="blog-empty" class="mt-10 hidden text-center text-muted-foreground" role="status">
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Return to ARC Cheats home from guides
        </Button>
      </div>
    </div>
  </section>
  <nav class="sr-only" aria-label="Guides index internal destinations">
    <ul>
      <li><a href="/blog/arc-raiders-combat-routing-to-extract/">Combat peel routing write-up</a></li>
      <li><a href="/blog/arc-raiders-player-esp-layout/">Readable ESP stack guide</a></li>
      <li><a href="/faq/">Loader policy questions</a></li>
      <li><a href="/about/">Publisher background page</a></li>
      <li><a href="/support/">Install ticket email</a></li>
      <li><a href="/products/arc-raiders/">Elite software listing</a></li>
      <li><a href="/products/">Multi-product catalog hub</a></li>
      <li><a href="/privacy/">Cookie privacy reference</a></li>
      <li><a href="/go/arc-raiders/">Raiders checkout hop from guides</a></li>
      <li><a href="/sitemap.xml">Crawl manifest from guides sr-only nav</a></li>
    </ul>
  </nav>
  <nav class="sr-only" aria-label="Share this page">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>{BLOG_INDEX_SHARE_LABELS.x}</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>{BLOG_INDEX_SHARE_LABELS.facebook}</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>{BLOG_INDEX_SHARE_LABELS.telegram}</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
