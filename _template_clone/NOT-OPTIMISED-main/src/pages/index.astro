---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { canonicalUrl, resolvePageSeo } from '../config/seo';
import { organizationSchema, webPageSchema, websiteSchema } from '../utils/schema';
import { heroSlides } from '../data/products';
import { isAbsoluteImageUrl, webpSrc } from '../utils/responsiveImage';
import { HOME_H1_SEO_SUFFIX } from '../config/homePageSeo';
import { HOME_SHARE_LABELS } from '../config/sharePageSeo';
import { SITEMAP_ANCHOR_BY_PATH } from '../config/sitemapAnchorSeo';
import SeoResponsiveHeadStyles from '../components/SeoResponsiveHeadStyles.astro';

const seo = resolvePageSeo('/');
const firstHeroSrc = heroSlides[0]?.src ?? '/logo.svg';
const heroLcpImage = isAbsoluteImageUrl(firstHeroSrc) ? firstHeroSrc : webpSrc(firstHeroSrc, 512);
const sharePageUrl = canonicalUrl('/');
const shareQuery = encodeURIComponent(sharePageUrl);
const shareTitle = encodeURIComponent('Arc Raiders Cheats');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    webPageSchema({ name: seo.title, description: seo.description, url: '/' }),
  ]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <SeoResponsiveHeadStyles />
  <HeroSection h1SeoSuffix={HOME_H1_SEO_SUFFIX} showOutlineH2 />
  <h2 class="sr-only">Below-hero landing sections</h2>
  <FeaturesSection showOutlineH2 />
  <ProductsSection uniqueAnchors />
  <WhySetupSection outlineH2 />
  <ContentSections uniqueAnchors faqQuestionHeadingTag="h3" />
  <nav class="sr-only" aria-label="Homepage internal destinations">
    <ul>
      <li><a href="/blog/">Patch-day guides hub</a></li>
      <li><a href="/faq/">Loader and access FAQ</a></li>
      <li><a href="/about/">Who publishes this site</a></li>
      <li><a href="/support/">Email support desk</a></li>
      <li><a href="/products/arc-raiders/">Elite tier listing on homepage</a></li>
      <li><a href="/blog/arc-raiders-setup-and-first-launch/">Portal-first setup article</a></li>
      <li><a href="/blog/arc-raiders-aimbot-and-fov-settings/">Aim smoothing primer</a></li>
      <li><a href="/blog/arc-raiders-extraction-and-threat-overlays/">Exit marker distance caps</a></li>
      <li><a href="/blog/arc-raiders-arc-threat-overlays/">ARC unit threat spacing primer</a></li>
      <li><a href="/blog/arc-raiders-combat-routing-to-extract/">Combat peel routing on landing</a></li>
      <li><a href="/blog/arc-raiders-player-esp-layout/">Player ESP stack on landing</a></li>
      <li><a href="/terms/">Checkout license terms</a></li>
      <li><a href="/go/arc-raiders/">Raiders /go/ hop from landing</a></li>
      <li><a href="/products/">Multi-SKU storefront roll-up</a></li>
      <li><a href="/forum/">Threaded community samples</a></li>
      <li><a href="/privacy/">Cookie analytics notice</a></li>
      <li><a href="/sitemap.xml">{SITEMAP_ANCHOR_BY_PATH['/']}</a></li>
    </ul>
  </nav>
  <nav class="sr-only" aria-label="Share this page">
    <ul>
      <li>
        <a href={`https://twitter.com/intent/tweet?url=${shareQuery}&text=${shareTitle}`}>{HOME_SHARE_LABELS.x}</a>
      </li>
      <li>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareQuery}`}>{HOME_SHARE_LABELS.facebook}</a>
      </li>
      <li>
        <a href={`https://t.me/share/url?url=${shareQuery}&text=${shareTitle}`}>{HOME_SHARE_LABELS.telegram}</a>
      </li>
    </ul>
  </nav>
</BaseLayout>
