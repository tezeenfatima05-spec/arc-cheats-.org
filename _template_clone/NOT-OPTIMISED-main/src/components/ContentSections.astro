---
import { t } from '../i18n';
import { getFeaturedBlogPosts } from '../data/blog';
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLandingFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

const homeFaqs = getLandingFaqs();
const featuredPosts = getFeaturedBlogPosts(3);

function blogReadLabel(slug: string): string {
  const labels: Record<string, string> = {
    'arc-raiders-setup-and-first-launch': 'Read portal setup guide',
    'arc-raiders-aimbot-and-fov-settings': 'Read aimbot tuning guide',
    'arc-raiders-player-esp-layout': 'Read player ESP layout guide',
    'arc-raiders-loot-and-world-esp-filters': 'Read loot filter guide',
    'arc-raiders-extraction-and-threat-overlays': 'Read extraction overlay guide',
    'arc-raiders-misc-camera-and-crosshair': 'Read misc settings guide',
    'arc-raiders-raid-atmosphere-and-arc-zones': 'Read ARC zone guide',
    'arc-raiders-arc-threat-overlays': 'Read threat overlay guide',
    'arc-raiders-combat-routing-to-extract': 'Read combat routing guide',
  };
  return labels[slug] ?? 'Read ARC Raiders guide';
}
---

<WorkflowSection />

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {featuredPosts.map((post, i) => (
        <BlogCard post={post} index={i} readLabel={blogReadLabel(post.slug)} />
      ))}
    </div>

    <div class="mt-10 flex justify-start lg:justify-center">
      <Button as="a" href={ROUTES.blog} variant="outline">
        Browse all ARC Raiders guides
        <Icon name="arrowRight" size={17} />
      </Button>
    </div>
  </div>
</section>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
