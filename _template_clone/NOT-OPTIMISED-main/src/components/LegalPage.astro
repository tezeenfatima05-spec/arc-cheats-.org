---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { ROUTES } from '../utils/path';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
  extraSections?: { heading: string; paragraphs: string[] }[];
  supportLinkLabel?: string;
  homeLinkLabel?: string;
  pageHeading?: string;
  sectionHeadingTag?: 'h2' | 'h3';
  extraSectionHeadingTag?: 'h2' | 'h3';
}

const {
  title,
  description,
  breadcrumbLabel,
  sections,
  extraSections = [],
  supportLinkLabel = 'Contact support',
  homeLinkLabel = 'Back to home',
  pageHeading,
  sectionHeadingTag = 'h2',
  extraSectionHeadingTag,
} = Astro.props;

const heading = pageHeading ?? title;
const SectionHeading = sectionHeadingTag;
const ExtraSectionHeading = extraSectionHeadingTag ?? sectionHeadingTag;
---

<article class="py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    <div class="text-left">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: breadcrumbLabel, path: Astro.url.pathname },
      ]}
    />
    </div>
    <header class="mt-4 space-y-4 text-center">
      <h1 class="text-3xl font-bold normal-case md:text-4xl">{heading}</h1>
      <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>
    </header>

    <h2 class="sr-only">Editorial and policy sections</h2>
    <Prose class="mt-10 max-w-none text-left">
      {sections.map((section) => (
        <section class="mt-8">
          <SectionHeading>{section.heading}</SectionHeading>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
      {extraSections.map((section) => (
        <section class="mt-8">
          <ExtraSectionHeading>{section.heading}</ExtraSectionHeading>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </Prose>

    <div class="mt-12 flex flex-wrap justify-center gap-3 border-t border-border pt-8">
      <Button as="a" href={ROUTES.support} variant="primary" size="sm">
        {supportLinkLabel}
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={ROUTES.home} variant="outline" size="sm">{homeLinkLabel}</Button>
    </div>
  </div>
</article>
